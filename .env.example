SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
DEPLOYER_PRIVATE_KEY=0x...
ETHERSCAN_API_KEY=...
SECRET_KYC_API_TOKEN=mock-token
SECRET_ELIGIBILITY_RULEBOOK='{"minScore":70}'
NEXT_PUBLIC_PRIVY_APP_ID=...

# --- hierarchy deployment (contracts/script/deploy-hierarchy.sh) ---
# The two investor wallets. They MUST be different addresses: the checker stores one leaf per
# account, so sharing a wallet silently overwrites one path with the other and collapses the tier
# split. Set both to the wallets Builder B's console will actually sign from — a subname is not
# trivially movable afterwards.
# Leave COMMENTED OUT to use defaults (retail = deployer, mm = a derived placeholder that cannot
# sign). An empty value is "set" as far as forge is concerned and fails to parse as an address.
#RETAIL_ADDRESS=
#MM_ADDRESS=
# Builder B's permissioned test token — ONE PER ISSUER, because one pool per issuer is the whole
# point. Each checker binds its token IMMUTABLY, so a checker must be redeployed if its token
# changes. Left blank, a per-issuer placeholder is derived and a warning printed.
#
# Two checkers bound to the SAME token would answer for each other's pool and quietly undo the
# isolation the multi-issuer model exists to provide, so these are deliberately not one variable.
# The name is PERMISSIONED_TOKEN_<ISSUER LABEL UPPERCASED>, matching script/hierarchy.json.
#PERMISSIONED_TOKEN_ACME=
#PERMISSIONED_TOKEN_ZENITH=
# Unsuffixed, this still works as a fallback for the FIRST issuer in the config, while Builder B
# has only one pool deployed.
#PERMISSIONED_TOKEN=
# Default name lifetime in seconds, used by any issuer or broker whose `ttl` is 0 in
# script/hierarchy.json. 30 days for development; set ~600 only when filming the lapse — a short
# value on a build day kills every test that follows.
#
# It applies to EVERY name that took the default, so give any broker that must survive the filmed
# lapse an explicit long `ttl` in the config instead. Otherwise the cascade takes all of them at
# once and reads as a global kill switch rather than one issuer dropping one broker.
BROKER_TTL=2592000
# Investor leaf lifetime in seconds.
LEAF_TTL=5184000
# Bump to derive a fresh commit–reveal secret if a commitment is ever burnt or front-run.
COMMIT_NONCE=1
